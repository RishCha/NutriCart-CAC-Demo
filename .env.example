# Names and safe placeholders only; the release does not load environment files.
FLASK_SECRET_KEY=
FLASK_COOKIE_SECURE=true
NUTRICART_PUBLIC_URL=http://127.0.0.1:5000

# Optional Supabase accounts and cross-device saved content. Both values are required.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_TIMEOUT_SECONDS=8

# Optional feedback delivery. Keep disabled until every Resend setting is configured.
NUTRICART_FEEDBACK_ENABLED=false
RESEND_API_KEY=
NUTRICART_FEEDBACK_FROM=
NUTRICART_FEEDBACK_TO=
