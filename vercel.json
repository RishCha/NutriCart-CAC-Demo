    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,instance/**,.venv/**,venv/**,.env,.env.*,**/*.db,**/*.db-*,**/*.sqlite*,**/*.zip,**/*.bak,data/*.json,data/*.csv}"
    }
  }
}
